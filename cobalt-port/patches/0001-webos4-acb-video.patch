+struct AcbApi {
+  decltype(&AcbAPI_create) create;
+  decltype(&AcbAPI_initialize) initialize;
+  decltype(&AcbAPI_setMediaId) set_media_id;
+  int (*set_media_video_data)(long, const char*, long*);
